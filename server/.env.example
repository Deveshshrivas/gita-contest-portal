# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/gita_exam_db

# Security & Tokens
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_example
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_example
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Optional Payment Gateway (Razorpay/Stripe - leave empty for mock sandbox mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Email Service (SMTP - leave empty to skip email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Gita Olympiad Directorate <no-reply@gitacontest.in>"

# File Storage (local or s3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
